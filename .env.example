# ═══════════════════════════════════════════════════════════════════════
# ClaimArmor AI — Environment Configuration
# Copy to .env and set values for your environment
# ═══════════════════════════════════════════════════════════════════════

# ── Core ──────────────────────────────────────────────────────────────
CLAIMARMOR_ENVIRONMENT=development          # development | staging | production
CLAIMARMOR_APP_VERSION=1.0.0
CLAIMARMOR_DEBUG=false
CLAIMARMOR_LOG_LEVEL=INFO
CLAIMARMOR_LOG_FORMAT=json                  # json | text

# ── Database ──────────────────────────────────────────────────────────
CLAIMARMOR_DATABASE_URL=sqlite:///claimarmor.db
# CLAIMARMOR_DATABASE_URL=postgresql+psycopg://claimarmor:password@localhost:5432/claimarmor
CLAIMARMOR_DB_POOL_SIZE=10
CLAIMARMOR_DB_MAX_OVERFLOW=20

# ── Authentication ────────────────────────────────────────────────────
CLAIMARMOR_AUTH_SECRET=change-this-secret-outside-demo
CLAIMARMOR_AUTH_TOKEN_LIFETIME_SECONDS=28800        # 8 hours
CLAIMARMOR_AUTH_REFRESH_TOKEN_LIFETIME_SECONDS=604800  # 7 days

# OIDC / SSO (optional)
# CLAIMARMOR_OIDC_ISSUER_URL=https://login.microsoftonline.com/tenant-id/v2.0
# CLAIMARMOR_OIDC_CLIENT_ID=your-client-id
# CLAIMARMOR_OIDC_CLIENT_SECRET=your-client-secret

# ── Encryption ────────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CLAIMARMOR_ENCRYPTION_KEY=

# ── Multi-tenancy ────────────────────────────────────────────────────
CLAIMARMOR_TENANT_ID=default
CLAIMARMOR_MULTI_TENANCY_ENABLED=false

# ── Redis / Celery ───────────────────────────────────────────────────
CLAIMARMOR_REDIS_URL=redis://localhost:6379/0
# CLAIMARMOR_CELERY_BROKER_URL=redis://localhost:6379/0
# CLAIMARMOR_CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── ML / Model ───────────────────────────────────────────────────────
CLAIMARMOR_MODEL_PATH=artifacts/risk_model.joblib
CLAIMARMOR_MODEL_METRICS_PATH=artifacts/model_metrics.json
# CLAIMARMOR_MLFLOW_TRACKING_URI=http://localhost:5000
CLAIMARMOR_MLFLOW_EXPERIMENT_NAME=claimarmor-risk-model
CLAIMARMOR_DRIFT_PSI_THRESHOLD=0.2

# ── LLM Providers ───────────────────────────────────────────────────
CLAIMARMOR_LLM_MODE=offline                 # offline | openai | openrouter | gemini
CLAIMARMOR_LLM_MODEL=gpt-4o-mini
CLAIMARMOR_LLM_MAX_TOKENS_PER_INVESTIGATION=8000

OPENAI_API_KEY=
OPENROUTER_API_KEY=
CLAIMARMOR_OPENROUTER_MODEL=openai/gpt-4o-mini

CLAIMARMOR_GEMINI_API_KEY=
CLAIMARMOR_GEMINI_MODEL=gemini-2.5-flash
CLAIMARMOR_GEMINI_STRUCTURED_MODEL=gemini-3.5-flash-lite
CLAIMARMOR_GEMINI_EXPLANATION_MODEL=gemini-3.5-flash-lite

# ── CORS ─────────────────────────────────────────────────────────────
CLAIMARMOR_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Rate Limiting ────────────────────────────────────────────────────
CLAIMARMOR_RATE_LIMIT_REQUESTS_PER_MINUTE=60
CLAIMARMOR_RATE_LIMIT_LOGIN_PER_MINUTE=10

# ── Notifications ────────────────────────────────────────────────────
# CLAIMARMOR_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX
CLAIMARMOR_REVIEW_QUEUE_ALERT_THRESHOLD=50
CLAIMARMOR_INVESTIGATION_SLA_SECONDS=30

# ── Observability ────────────────────────────────────────────────────
CLAIMARMOR_PROMETHEUS_ENABLED=true
# CLAIMARMOR_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# CLAIMARMOR_SENTRY_DSN=
